# Локальный пакет для Arch/CachyOS: собирает Volna из этого же репозитория.
# Сборка: cd packaging/arch && makepkg -si
pkgname=volna
pkgver=0.1.0
pkgrel=9
pkgdesc="Неофициальный десктоп-плеер YouTube Music с «Моей волной»"
arch=('x86_64')
license=('Apache-2.0')
# GStreamer plays the audio itself (playbin3, opus, aac, pulse/pipewire, scaletempo).
depends=('webkit2gtk-4.1' 'gtk3' 'yt-dlp' 'deno' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-libav' 'bgutil-ytdlp-pot-provider')
optdepends=('xray: режим VLESS в настройках сети')
makedepends=('cargo')  # + bun (стоит вне pacman)
options=('!lto' '!debug')

_root="$(realpath "$startdir/../..")"
# Cargo honours CARGO_TARGET_DIR (a shared target dir); install from there too.
_target="${CARGO_TARGET_DIR:-$_root/target}"

build() {
  cd "$_root/ui"
  bun install --frozen-lockfile
  bun run tauri build --no-bundle
  cd "$_root"
  cargo build --release -p volna-daemon
}

package() {
  # volna: the daemon (player, tray, MPRIS); volna-window: the UI process it starts.
  install -Dm755 "$_target/release/volna" "$pkgdir/usr/bin/volna"
  install -Dm755 "$_target/release/volna-window" "$pkgdir/usr/bin/volna-window"
  install -Dm644 "$_root/src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/volna.png"
  install -Dm644 "$_root/src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/volna.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/volna.desktop" <<DESK
[Desktop Entry]
Type=Application
Name=Volna
Comment=YouTube Music с «Моей волной»
Exec=volna
Icon=volna
Categories=AudioVideo;Audio;Player;
StartupWMClass=volna-window
DESK
}
