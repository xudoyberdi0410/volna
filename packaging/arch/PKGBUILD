# Локальный пакет для Arch/CachyOS: собирает Volna из этого же репозитория.
# Сборка: cd packaging/arch && makepkg -si
pkgname=volna
pkgver=0.1.0
pkgrel=10
pkgdesc="Неофициальный десктоп-плеер YouTube Music с «Моей волной»"
arch=('x86_64')
license=('Apache-2.0')
# GStreamer plays the audio itself (playbin3, opus, aac, pulse/pipewire, scaletempo).
depends=('gtk3' 'yt-dlp' 'deno' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-libav' 'bgutil-ytdlp-pot-provider')
optdepends=('xray: режим VLESS в настройках сети'
            'webkit2gtk-4.1: вход в Яндекс в окне приложения')
makedepends=('cargo' 'cmake' 'ninja' 'clang')  # + flutter (стоит вне pacman)
options=('!lto' '!debug')

_root="$(realpath "$startdir/../..")"
# Cargo honours CARGO_TARGET_DIR (a shared target dir); install from there too.
_target="${CARGO_TARGET_DIR:-$_root/target}"

build() {
  cd "$_root"
  cargo build --release -p volna-daemon
  cd "$_root/app"
  flutter build linux --release
}

package() {
  # volna: the daemon (player, tray, MPRIS); it starts the Flutter window
  # from /usr/lib/volna, which finds the daemon next to itself.
  install -Dm755 "$_target/release/volna" "$pkgdir/usr/bin/volna"
  install -dm755 "$pkgdir/usr/lib/volna"
  cp -a "$_root/app/build/linux/x64/release/bundle/." "$pkgdir/usr/lib/volna/"
  ln -s /usr/bin/volna "$pkgdir/usr/lib/volna/volna"
  install -Dm644 "$_root/packaging/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/volna.png"
  install -Dm644 "$_root/packaging/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/volna.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/uz.khudoberdi.volna.desktop" <<DESK
[Desktop Entry]
Type=Application
Name=Volna
Comment=YouTube Music с «Моей волной»
Exec=volna
Icon=volna
Categories=AudioVideo;Audio;Player;
StartupWMClass=uz.khudoberdi.volna
DESK
}
