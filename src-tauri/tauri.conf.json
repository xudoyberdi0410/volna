{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Volna",
  "identifier": "uz.khudoberdi.volna",
  "mainBinaryName": "volna-window",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --cwd ../ui dev",
    "beforeBuildCommand": "bun run --cwd ../ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Volna",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "YouTube Music player with My Wave",
    "longDescription": "Unofficial desktop YouTube Music player with a local «My Wave» radio, a built-in proxy and VLESS (xray) client. Streams only, no downloads.",
    "publisher": "Khudoberdi Abdujalilov",
    "copyright": "Volna contributors; UI based on Monochrome (Apache-2.0)",
    "license": "Apache-2.0",
    "linux": {
      "deb": {
        "section": "sound",
        "depends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good"],
        "recommends": ["gstreamer1.0-libav"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
