{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Volna",
    "identifier": "uz.khudoberdi.volna",
    "build": {
        "frontendDist": "../ui/dist",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "bun run --cwd ../ui dev",
        "beforeBuildCommand": "bun run --cwd ../ui build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Volna",
                "width": 1280,
                "height": 820,
                "minWidth": 800,
                "minHeight": 560
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["appimage", "deb", "nsis"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
